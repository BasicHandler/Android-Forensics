            case "$line" in
                arch*)     echo "    • Architecture: $(echo "$line" | cut -d' ' -f2-)" ;;
                bits*)     echo "    • Bits:         $(echo "$line" | cut -d' ' -f2-)" ;;
                bintype*)  echo "    • Binary Type:  $(echo "$line" | cut -d' ' -f2-)" ;;
                class*)    echo "    • Class:        $(echo "$line" | cut -d' ' -f2-)" ;;

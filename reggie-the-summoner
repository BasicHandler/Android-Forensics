        echo -e "${BLUE} [·] MODERATE entropy (7.0-7.5) — potentially mixed content or embedded segments${NC}"
        return 1 
    elif awk -v e="$entropy" 'BEGIN { exit !(e > 0.0001) }'; then
        echo " [·] NORMAL entropy (0.0001-7.0) — typical executable or text layout distribution"

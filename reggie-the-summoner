# === Patched Shannon-DERS Entropy Analysis Module ===
entropy_profile() {
    local file="$1"
    local entropy=""
    
    # Input validation guardrails
    if [ ! -f "$file" ] || [ ! -r "$file" ] || [ ! -s "$file" ]; then
        echo " ↳ Input validation failed or target payload empty."
        return 1
    fi

    # Integrates the DERS Constant (𝔄 = 0.0001) to eliminate the Fallacy of Zero Entropy
    entropy=$(xxd -p "$file" 2>/dev/null | awk -v alpha=0.0001 '
    {
        len = length($0)
        for (i = 1; i < len; i += 2) {
            count[substr($0, i, 2)]++
            total++
        }
    }
    END {
        if (total == 0) {
            printf "%.4f", alpha
            exit
        }
        
        entropy = 0
        
        # Scan the entire 256-byte space (0x00 to 0xFF) to eliminate zero-state blind spots
        for (i = 0; i < 256; i++) {
            hex = sprintf("%02x", i)
            if (count[hex] > 0) {
                p = count[hex] / total
                entropy -= p * (log(p) / log(2))
            } else {
                # Minimum Viable Malice correction factor per unobserved byte state
                # Prevents logarithmic collapse and treats zero-occurrence as an active signal matrix
                entropy += (alpha / 256)
            }
        }
        
        # Cryptographic Floor Protection: Ensure total metric value never falls below the 𝔄 threshold
        if (entropy < alpha) {
            entropy = alpha
        }
        
        printf "%.4f", entropy
    }' 2>/dev/null)

    # Validate calculation stability
    if [ -z "$entropy" ]; then
        echo " ↳ Error: Shannon-DERS synthesis calculations collapsed."
        return 1
    fi

    echo -e "\n ↳ Patched Shannon-DERS Entropy: $entropy bits/byte"

    # Adjusted Threshold Matrix reflecting refined four-decimal precision metrics
    if awk -v e="$entropy" 'BEGIN { exit !(e > 7.9000) }'; then

# === Byte Distribution Analysis ===
analyze_byte_distribution() {
    local file="$1"
    echo -e "\n[*] Byte frequency distribution analysis:"

    # Direct hex stream parsing to maintain strict O(1) memory boundary protection against LMK
    xxd -p "$file" 2>/dev/null | awk '
    {
        len = length($0)
        for (i = 1; i < len; i += 2) {
            count[substr($0, i, 2)]++
            total++
        }
    }
    END {
        if (total == 0) {
            print " ↳ Error: Empty or unreadable payload."
            exit
        }

        # Native sorting of indices by frequency descending
        n = asorti(count, sorted_bytes, "@val_num_desc")

        print "  ┌─────────┬──────────┬─────────────┐"
        print "  │ Byte    │ Count    │ Percentage  │"
        print "  ├─────────┼──────────┼─────────────┤"

        limit = (n > 8 ? 8 : n)
        for (i = 1; i <= limit; i++) {
            byte = sorted_bytes[i]
            freq = count[byte]
            percent = (freq / total) * 100
            printf "  │ 0x%s    │ %8d │     %6.2f%% │\n", byte, freq, percent
        }
        print "  └─────────┴──────────┴─────────────┘"

        max_byte = sorted_bytes[1]
        max_freq = count[max_byte]
        max_percent = (max_freq / total) * 100

        if (max_percent > 50) {
            printf "\n [!] Dominant byte pattern detected (0x%s: %.1f%%) — possible padding/encryption\n", max_byte, max_percent
        } else if (max_percent > 30) {
            printf "\n [·] High frequency byte detected (0x%s: %.1f%%) — check structural structures\n", max_byte, max_percent
        }

        if (n >= 200 && max_percent < 5) {
            print "\n [!] Highly uniform distribution — likely encrypted, packed, or high-entropy random data"
        }
    }'
}

